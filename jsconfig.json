{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["packages/**/*.js", "packages/**/*.jsx", "packages/**/*.mjs", "packages/**/*.ts", "packages/**/*.tsx", "tools/**/*.mjs", "tools/**/*.js", "tools/**/*.ts", "build/**/*.mjs"],
  "exclude": ["node_modules", "**/*.test.mjs"]
}
