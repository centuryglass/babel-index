{
  "name": "babel-index",
  "version": "0.0.0",
  "private": true,
  "description": "An AI art experiment based around the Library of Babel.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate:figures": "node --import ./build/register.mjs tools/center-placement/hexagon-plan.mjs",
    "generate:mips": "node --import ./build/register.mjs packages/pipeline/index.ts",
    "generate:embeddings": "node --import ./build/register.mjs tools/embed/embed.ts",
    "upload:r2": "node --import ./build/register.mjs tools/upload/upload-r2.ts",
    "test": "node --import ./build/register.mjs --test $(find packages tools -name '*.test.mjs' -o -name '*.test.ts')",
    "test:e2e": "node --import ./build/register.mjs --test --test-concurrency=1 packages/web/e2e/*.e2e.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "demo": "node --import ./build/register.mjs packages/server/index.ts",
    "demo:watch": "node --watch --import ./build/register.mjs packages/server/index.ts --watch"
  },
  "dependencies": {
    "any-ascii": "^0.3.3",
    "esbuild": "^0.28.2",
    "express": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "wink-lemmatizer": "^3.0.4"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.2.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "playwright": "^1.62.1",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2"
  }
}
